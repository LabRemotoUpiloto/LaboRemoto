# Copiar a /etc/laboremoto-brokers/camaras.env (permisos 600, dueño root). NO versionar el archivo real.
PORT=8092
SHINOBI_API_KEY=<la key real de Shinobi>
SHINOBI_LOCAL_PORT=8082
KEYCLOAK_JWKS_URL=http://52.14.162.232/auth/realms/laboratorio-semillero/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://52.14.162.232/auth/realms/laboratorio-semillero
# mid de Shinobi -> camara Reolink real con PTZ (IP y credenciales nunca salen de la Pi)
PTZ_CAMERAS_JSON={"Camara1":{"host":"172.16.118.115","user":"admin","pass":"<clave>"}}
# mid de Shinobi -> path de MediaMTX (WebRTC)
WEBRTC_PATHS_JSON={"Camara1":"cam00"}
MEDIAMTX_WEBRTC_PORT=8889
# --- Administración de cámaras (opcionales; estos son los valores por defecto) ---
# El registro de cámaras sustituye a los dos mapas de arriba cuando tiene cámaras (esos quedan como respaldo/semilla).
#SHINOBI_GROUP_KEY=pilabpiloto
#CAMARAS_REGISTRO=/opt/laboremoto-brokers/data/camaras.json
