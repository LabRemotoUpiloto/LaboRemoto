# Copiar a /etc/laboremoto-brokers/gateway.env. No lleva secretos: solo reparte rutas.
# Mismo puerto que usaba el antiguo nvr-broker, así el túnel a AWS y el nginx no cambian.
PORT=8091
UPSTREAM_CAMARAS=http://127.0.0.1:8092
UPSTREAM_SESIONES=http://127.0.0.1:8093
# broker-moodle puede estar en otra máquina: apuntar aquí a su dirección.
UPSTREAM_MOODLE=http://127.0.0.1:8094
