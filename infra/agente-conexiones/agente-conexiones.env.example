# Copiar a /etc/laboremoto-brokers/agente-conexiones.env (permisos 600, dueño root). NO versionar el archivo real.
# Id del dispositivo: debe existir en DISPOSITIVOS_JSON del broker (sesiones.env) con este mismo token.
CONEXIONES_DISPOSITIVO=pi4
CONEXIONES_TOKEN=<token del dispositivo (lo mismo que en DISPOSITIVOS_JSON)>
# Valores por defecto (opcionales):
#CONEXIONES_URL=http://127.0.0.1:8093/nvr/dispositivos/evento
#CONEXIONES_LOG=/var/log/auth.log
