# Copiar a /etc/laboremoto-brokers/sesiones.env (permisos 600, dueño root). NO versionar el archivo real.
PORT=8093
KEYCLOAK_JWKS_URL=http://52.14.162.232/auth/realms/laboratorio-semillero/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://52.14.162.232/auth/realms/laboratorio-semillero
# Conservar el historial del broker anterior: copiar /opt/nvr-broker/sesiones.jsonl aquí.
SESIONES_FILE=/opt/laboremoto-brokers/data/sesiones.jsonl
# Flujo de Power Automate (ver infra/registro-excel/README.md); vacío = no reenviar
SESIONES_WEBHOOK_URL=
IPINFO_TOKEN=
# Dispositivos que reportan conexiones SSH (ver ../agente-conexiones). El token debe coincidir con el del agente: openssl rand -hex 24
DISPOSITIVOS_JSON={"pi4":{"nombre":"Pi4","token":"<token>"}}
DISPOSITIVOS_FILE=/opt/laboremoto-brokers/data/dispositivos.jsonl
