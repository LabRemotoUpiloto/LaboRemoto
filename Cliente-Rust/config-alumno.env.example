# Configuración de la app instalada (alumnos).
# Copia este archivo, quítale ".example" del nombre para que se llame solo ".env" y llena los
# valores que te entregó el docente por el canal privado del curso. NO lo subas a ningún repositorio.
# Ruta donde debe quedar -> ver CONFIGURACION-ALUMNOS.md

# Modelo de IA (chat)
GROQ_API_KEY=
# Opcional: modelo a usar (si lo dejas vacío usa el predeterminado)
OPENAI_MODEL=

# Prácticas de Linux
PRACTICE_LINUX_TUNNEL_HOST=
PRACTICE_LINUX_TUNNEL_PORT=
PRACTICE_LINUX_TUNNEL_USER=
PRACTICE_LINUX_TUNNEL_PASSWORD=
PRACTICE_LINUX_API_REMOTE_PORT=
PRACTICE_LINUX_API_TOKEN=
PRACTICE_LINUX_SSH_HOST=
PRACTICE_LINUX_SSH_PORT=
