{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cliente SSH Unipiloto",
  "version": "3.5.1",
  "identifier": "co.unipiloto.sshclient",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Laboratorio remoto Unipiloto",
        "width": 800,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Haider2231/Releases-Cliente-SSH-Unipiloto/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNjJBMDYzNTMyRTNFMkIKUldRclBpNVRZNkJpZ3NsYlJSUTlLU25vK2NSVldpVUJLUW1ETStodHhlUlV2VlpwRko4NW95dGMK"
    }
  }
}






