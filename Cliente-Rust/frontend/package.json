{
  "name": "ssh-ai-client-web",
  "version": "3.5.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 5174 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\" & vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
