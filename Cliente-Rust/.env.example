# ─── Configuración de Moodle ───
# URL base de tu instalación de Moodle (sin trailing slash)
MOODLE_URL=https://tu-moodle.com

# Token de servicios web de Moodle
# IMPORTANTE: Este token debe tener permisos de profesor/gestor para calificar
# Para obtenerlo: Administración del sitio > Plugins > Servicios web > Gestionar tokens
MOODLE_TOKEN=tu_token_aqui

# ─── NVR Shinobi (cámaras, cmd::nvr) ───
# El cliente ya NO necesita SHINOBI_API_KEY ni una clave SSH propia — el
# consumo va contra el broker desplegado en la Pi (infra/nvr-broker),
# alcanzable públicamente vía el mismo túnel inverso + nginx que expone
# Keycloak. La SHINOBI_API_KEY real vive solo en el broker (systemd
# nvr-broker.service en la Pi), nunca en un build distribuido a alumnos.
# El cliente solo manda el access_token de Keycloak que ya tiene del login;
# el broker lo valida contra el JWKS institucional antes de autorizar nada.
# Host del broker hardcodeado en shinobi.rs (NVR_BROKER_HOST) — no es un
# secreto, es una URL pública igual que KEYCLOAK_BASE_URL.

# ─── Catálogo externo de prácticas (cmd::integration::lab_practices) ───
# Aún no existe una implementación real de esta API (aplicativo de autoría
# de terceros) — si se deja sin configurar, el módulo sirve un catálogo mock
# embebido para poder desarrollar/probar el resto del flujo. Contenido NO
# confiable: nunca debe traer host/usuario/contraseña, solo texto pedagógico
# y execution_requirements declarativos (ver lab_practices.rs).
LAB_PRACTICES_API_URL=
LAB_PRACTICES_API_KEY=

# ─── Configuración de IA (opcional) ───
# Clave API de OpenAI para el asistente de prácticas
OPENAI_API_KEY=tu_api_key_aqui

# ─── Raspberry Pi (modo Agente sin SSH manual) ───
# El agente puede conectarse a la Pi del laboratorio con estas credenciales
PI4_USER=pi
# Usa comillas simples si la contraseña tiene " o caracteres especiales
PI4_PASSWORD='tu_password_aqui'
# Opcional (por defecto: 200.115.181.211:9000)
# PI4_HOST=200.115.181.211
# PI4_PORT=9000

# ─── Firma de actualizaciones (Tauri updater) ───
# Ruta a la llave privada generada con: cargo tauri signer generate
TAURI_SIGNING_PRIVATE_KEY_PATH=.tauri/keys.key
# Contraseña de la llave privada
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ─── Autenticación OAuth 2.1 — Keycloak ───
# URL base del servidor Keycloak
# Producción: túnel SSH inverso expuesto en AWS via Nginx
KEYCLOAK_BASE_URL=http://keycloak-url/auth

# Realm institucional de Keycloak federado con Active Directory
KEYCLOAK_REALM=realm_aqui

# Client ID público de la aplicación (sin client_secret — flujo PKCE)
KEYCLOAK_CLIENT_ID=client_id_aqui

# Nota: el redirect_uri es dinámico (127.0.0.1:puerto_aleatorio/callback)
# No se configura aquí; el backend lo genera en auth::callback::CallbackServer::spawn()
