@startuml flujo-datos
!theme plain
skinparam backgroundColor #1e1e1e
skinparam defaultTextColor #d4d4d4

title Flujos de Datos Principales - Cliente SSH Unipiloto

actor "Usuario" as User
participant "Frontend\n(React)" as FE
participant "Backend\n(Rust)" as BE
participant "SSH Server\n(remoto)" as SSH
participant "OpenAI/Claude\nAPI" as AI
participant "Supabase" as DB
participant "LDAP" as LDAP

== Flujo 1: Conexión SSH ==
User -> FE: Conectar a servidor
FE -> BE: invoke('ssh_connect', {host, user, pass})
BE -> SSH: TCP connect + handshake
SSH --> BE: SSH session established
BE -> BE: Generar UUID sesión
BE --> FE: Return session_id
BE -> FE: emit('ssh_out_{id}', data)
FE -> FE: xterm.write(data)
User -> FE: Escribe comando
FE -> BE: invoke('ssh_stdin', {id, data})
BE -> SSH: Send stdin
SSH --> BE: stdout/stderr
BE -> FE: emit('ssh_out_{id}', output)

== Flujo 2: Chat con IA ==
User -> FE: Envía prompt al chat
FE -> BE: invoke('ai_chat', {prompt, history, mode})
BE -> BE: Construir contexto\n+ memoria efímera
BE -> AI: HTTPS POST /v1/chat/completions\nBearer {API_KEY}
AI --> BE: Streaming response (JSON)
BE -> BE: Parsear respuesta\n+ validar seguridad
BE --> FE: Return {ai_response, commands}
FE -> FE: Renderizar respuesta
alt Usuario confirma comando
  User -> FE: Ejecutar comando
  FE -> BE: invoke('ssh_stdin', {command})
  BE -> SSH: Ejecutar en servidor remoto
  SSH --> BE: Output
  BE -> FE: emit('ssh_out_{id}', output)
end

== Flujo 3: Captura de Logs ==
User -> FE: Cierra sesión SSH
FE -> FE: SerializeAddon.serialize()\n→ ANSI raw
FE -> FE: ansi-to-html conversion
FE -> BE: invoke('save_session_log', {metadata, html})
BE -> BE: Guardar en filesystem\nsavedLogs/{uuid}.html
alt Modo Cloud habilitado
  BE -> DB: POST /storage/v1/object/logs\nUpload HTML
  DB --> BE: Storage URL
  BE -> DB: POST /rest/v1/session_logs\nInsert metadata
  DB --> BE: Log ID
end
BE --> FE: Success

== Flujo 4: Autenticación ==
User -> FE: Login (username, password)
FE -> BE: invoke('login', {username, password})
BE -> LDAP: LDAP Bind\nldap://server:389
LDAP --> BE: Bind success
BE -> LDAP: Search groups\n(CN=students, CN=professors)
LDAP --> BE: memberOf attributes
BE -> BE: Mapear grupos → role_id\n(1=Student, 2=Prof, 3=Admin)
BE -> DB: POST /rest/v1/users\nUpsert user
DB --> BE: user_id
BE -> BE: Generar JWT\nHS256(user_id, role_id)
BE --> FE: {token, user_id, role_id}
FE -> FE: localStorage.setItem('token', jwt)

== Flujo 5: Visualización de Logs ==
User -> FE: Navega a página Logs
FE -> BE: invoke('list_session_logs')
BE -> DB: GET /rest/v1/session_logs\nWHERE user_id = {id}
DB --> BE: Array de metadatos
BE --> FE: [{session_id, host, duration}]
FE -> FE: Renderizar cards
User -> FE: Click en log
FE -> BE: invoke('get_session_log_content', {session_id})
alt Log en Storage
  BE -> DB: GET /storage/v1/object/logs/{path}
  DB --> BE: HTML content
else Log local
  BE -> BE: fs::read(savedLogs/{id}.html)
end
BE --> FE: HTML string
FE -> FE: Renderizar en <iframe>

== Flujo 6: Transferencia SFTP ==
User -> FE: Upload archivo
FE -> BE: invoke('sftp_upload_start', {local_path, remote_path})
BE -> BE: spawn_blocking\n(libssh2 es síncrono)
BE -> SSH: SFTP PUT\nChunks de 8KB
SSH --> BE: ACK chunks
loop Cada chunk transferido
  BE -> FE: emit('sftp_progress_{id}', {percent})
  FE -> FE: Actualizar barra progreso
end
SSH --> BE: Transfer complete
BE --> FE: Success

@enduml
