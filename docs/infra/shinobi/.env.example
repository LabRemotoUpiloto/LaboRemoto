# Estas variables las consume infra/shinobi/docker-compose.yml vía ${VAR}.
# Copia este archivo a ".env" en el mismo directorio y completa los valores
# reales antes de ejecutar `docker compose up -d`. NUNCA commitees el .env
# real (contiene credenciales).

# ─── Puertos de Shinobi ───
# Web + API + HLS
SHINOBI_WEB_PORT=8080
# Ingesta RTMP desde las Pis/Jetsons de práctica (edges)
SHINOBI_RTMP_PORT=1935

# ─── Cuenta admin inicial de Shinobi ───
# Se usa para crear el superusuario en el primer acceso a la UI web.
SHINOBI_ADMIN_EMAIL=admin@cambia_esto.local
SHINOBI_ADMIN_PASSWORD=cambia_esto

# ─── Base de datos (MariaDB) ───
DB_ROOT_PASSWORD=cambia_esto
DB_NAME=ccio
DB_USER=majesticflame
DB_PASSWORD=cambia_esto

# ─── Rutas de volúmenes persistentes ───
# Configuración de Shinobi (monitors, groups, ajustes)
NVR_CONFIG_PATH=./config
# IMPORTANTE: debe apuntar a un disco externo montado en la Pi (ej. USB/SSD
# en /mnt/nvr), NUNCA a la tarjeta SD. Las grabaciones continuas de varias
# cámaras degradan la SD rápido y su espacio suele ser insuficiente.
NVR_VIDEOS_PATH=/mnt/nvr/videos
# Datos de la base de datos MariaDB
NVR_DB_PATH=./database
