# Arquitectura general de LaboRemoto: subsistemas, sus componentes y cómo interactúan.
# Vista de alto nivel, de arriba hacia abajo: sin direcciones, puertos ni protocolos.
# Render:  d2 docs/arquitectura/arquitectura-general.d2 docs/arquitectura/arquitectura-general.svg
#
# Convenciones (para que todo se vea igual):
#   - Subsistema: recuadro de color claro, título arriba a la izquierda y logo arriba a la derecha.
#   - Componente: recuadro blanco del mismo tamaño, con ícono y nombre corto, borde del color de su
#     subsistema.
#   - Flechas: entre subsistemas, con un verbo corto. Naranja = la voz; punteado gris = monitoreo.
# Para añadir un componente: copia uno dentro de su subsistema y, si hace falta, su flecha en
# «Conexiones». Íconos: Lucide y Simple Icons por jsDelivr, con versión fijada.

vars: {
  d2-config: {
    layout-engine: elk
    pad: 60
  }
  lucide: "https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons"
  marcas: "https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons"
}

direction: down

titulo: Arquitectura general de LaboRemoto {
  near: top-center
  shape: text
  style: {
    font-size: 40
    bold: true
  }
}

classes: {
  sub: {
    label.near: top-left
    icon.near: top-right
    style: {
      border-radius: 14
      stroke-width: 2
      font-size: 22
      bold: true
    }
  }
  comp: {
    shape: rectangle
    width: 180
    height: 130
    label.near: bottom-center
    style: {
      fill: "#ffffff"
      border-radius: 8
      stroke-width: 2
      font-size: 16
      bold: true
    }
  }
}

# Todas las flechas con el mismo grosor y color; las de voz y monitoreo cambian abajo.
(** -> **)[*].style: {
  stroke: "#37474f"
  stroke-width: 2
  font-size: 18
}
(** <-> **)[*].style: {
  stroke: "#37474f"
  stroke-width: 2
  font-size: 18
}

# ── Usuarios y cliente ──────────────────────────────────────────────────────────────────────

usuarios: "Usuarios" {
  class: sub
  icon: ${lucide}/users.svg
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  personas: "Estudiante,\ndocente o admin" {
    class: comp
    style.stroke: "#1565c0"
    icon: ${lucide}/user.svg
  }
}

cliente: "Cliente" {
  class: sub
  icon: ${lucide}/monitor.svg
  style.fill: "#fdecea"
  style.stroke: "#d51f22"

  app: "App de escritorio" {
    class: comp
    style.stroke: "#d51f22"
    icon: ${lucide}/app-window.svg
  }
}

# ── Acceso ──────────────────────────────────────────────────────────────────────────────────

acceso: "Acceso" {
  class: sub
  icon: ${lucide}/lock.svg
  style.fill: "#ede7f6"
  style.stroke: "#5e35b1"

  login: "Inicio de sesión" {
    class: comp
    style.stroke: "#5e35b1"
    icon: ${lucide}/shield-check.svg
  }
  roles: "Usuarios y roles" {
    class: comp
    style.stroke: "#5e35b1"
    icon: ${lucide}/database.svg
  }
}

universidad: "Universidad" {
  class: sub
  icon: ${lucide}/landmark.svg
  style.fill: "#f1f1f1"
  style.stroke: "#616161"

  cuentas: "Cuentas\ninstitucionales" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/graduation-cap.svg
  }
}

# ── Servidores del laboratorio ──────────────────────────────────────────────────────────────

jetson: "NVIDIA Jetson · Tutor de voz" {
  class: sub
  icon: ${marcas}/nvidia.svg
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"
  # En fila y en este orden: escucha → piensa → responde.
  grid-columns: 3
  grid-gap: 20

  escucha: "Voz a texto" {
    class: comp
    style.stroke: "#ef6c00"
    icon: ${lucide}/mic.svg
  }
  modelo: "Modelo de IA local" {
    class: comp
    style.stroke: "#ef6c00"
    icon: ${lucide}/brain.svg
  }
  habla: "Texto a voz" {
    class: comp
    style.stroke: "#ef6c00"
    icon: ${lucide}/audio-lines.svg
  }
}

pi4: "Raspberry Pi 4 · Laboratorio" {
  class: sub
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e8f1fb"
  style.stroke: "#1e88e5"
  grid-columns: 5
  grid-gap: 20

  terminal: "Terminal" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/terminal.svg
  }
  video: "Video en vivo" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/video.svg
  }
  practicas: "API de prácticas" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/book-open-check.svg
  }
  lab: "API del laboratorio" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/layout-dashboard.svg
  }
  bd: "Sesiones y encuestas" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/database.svg
  }
}

pi5: "Raspberry Pi 5 · Cursos y robot" {
  class: sub
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e9f6ec"
  style.stroke: "#2e7d32"

  moodle: "Moodle" {
    class: comp
    style.stroke: "#2e7d32"
    icon: ${marcas}/moodle.svg
  }
  api_robot: "API del robot" {
    class: comp
    style.stroke: "#2e7d32"
    icon: ${lucide}/blocks.svg
  }
}

pi5_auto: "Raspberry Pi 5 · Automatización" {
  class: sub
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#f3ecfa"
  style.stroke: "#7e57c2"

  api_auto: "API de automatización" {
    class: comp
    style.stroke: "#7e57c2"
    icon: ${lucide}/workflow.svg
  }
}

monitoreo: "Monitoreo" {
  class: sub
  icon: ${lucide}/activity.svg
  style.fill: "#f1f1f1"
  style.stroke: "#616161"

  vigia: "Vigila las máquinas" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/gauge.svg
  }
  teams: "Alertas a Teams" {
    class: comp
    style.stroke: "#616161"
    icon: ${marcas}/microsoftteams.svg
  }
}

# ── Equipos reales ──────────────────────────────────────────────────────────────────────────

equipos: "Equipos reales · solo red interna" {
  class: sub
  # Título y logo abajo: aquí las flechas llegan a los componentes y cruzarían el título de arriba.
  label.near: bottom-left
  icon.near: bottom-right
  icon: ${lucide}/cpu.svg
  style.fill: "#f1f1f1"
  style.stroke: "#616161"

  camaras: "5 cámaras IP" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/cctv.svg
  }
  robot: "Robot LEGO EV3" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/bot.svg
  }
  plc: "PLC" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/microchip.svg
  }
}

# ── Conexiones ──────────────────────────────────────────────────────────────────────────────

usuarios -> cliente: usa

cliente -> acceso: "inicia sesión"
acceso -> universidad: "valida la cuenta"

cliente -> jetson: "habla y escucha" {
  style.stroke: "#ef6c00"
  style.stroke-width: 3
}
cliente -> pi4: "terminal, video y prácticas"
cliente -> pi5: "cursos y robot"
cliente -> pi5_auto: "automatización"

jetson -> pi4: "lee la práctica" {
  style.stroke: "#ef6c00"
  style.stroke-width: 3
}
jetson -> pi5: "estado del robot" {
  style.stroke: "#ef6c00"
  style.stroke-width: 3
}

pi4 -> pi5: "envía la nota"
monitoreo -> pi4: vigila {
  style.stroke: "#757575"
  style.stroke-dash: 5
}

pi4 <-> equipos.camaras: "video y movimiento"
pi5 -> equipos.robot: "ejecuta los bloques"
pi5_auto -> equipos.plc: controla
