# Arquitectura general de LaboRemoto: subsistemas, sus componentes y cómo interactúan.
# Vista de alto nivel: sin direcciones, puertos ni protocolos.
# Render:  d2 docs/arquitectura/arquitectura-general.d2 docs/arquitectura/arquitectura-general.svg
#
# Cuadrícula de 6 columnas y 4 filas, de arriba hacia abajo. Las celdas «vacio_*» son huecos para que
# las flechas queden rectas. Filas: 1 usuarios, cliente e inicio de sesión · 2 servidores · 3 tutor de
# voz · 4 equipos reales. Cada recuadro grande es un subsistema; los pequeños son sus componentes.
# Para añadir un componente: copia un recuadro pequeño dentro de su subsistema; para una conexión,
# agrega la flecha abajo, en «Conexiones».
# Íconos: Lucide y Simple Icons por jsDelivr, con versión fijada. Naranja = la voz; punteado = apoyo.

vars: {
  d2-config: {
    pad: 50
  }
  lucide: "https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons"
  marcas: "https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons"
}

classes: {
  # Componente: recuadro blanco con ícono y nombre corto.
  comp: {
    shape: rectangle
    width: 190
    height: 150
    label.near: bottom-center
    style: {
      fill: "#ffffff"
      border-radius: 8
      stroke-width: 2
      font-size: 17
      bold: true
    }
  }
  # Subsistema: recuadro de color que agrupa componentes.
  sub: {
    label.near: top-left
    style: {
      border-radius: 14
      font-size: 22
      bold: true
      stroke-width: 3
    }
  }
  hueco: {
    label: ""
    width: 20
    height: 20
    style: {
      opacity: 0
    }
  }
}

grid-rows: 4
grid-columns: 6
grid-gap: 110

# ── Fila 1 · Usuarios, cliente e inicio de sesión ───────────────────────────────────────────

vacio_1: { class: hueco }

usuarios: "Usuarios" {
  class: sub
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  personas: "Estudiante\nDocente · Admin" {
    class: comp
    style.stroke: "#1565c0"
    icon: ${lucide}/users.svg
  }
}

cliente: "Cliente" {
  class: sub
  style.fill: "#fdecea"
  style.stroke: "#d51f22"

  app: "App de escritorio" {
    class: comp
    style.stroke: "#d51f22"
    icon: ${lucide}/app-window.svg
  }
}

acceso: "Acceso" {
  class: sub
  style.fill: "#ede7f6"
  style.stroke: "#5e35b1"

  login: "Servidor de\ninicio de sesión" {
    class: comp
    style.stroke: "#5e35b1"
    icon: ${lucide}/shield-check.svg
  }
}

universidad: "Universidad" {
  class: sub
  style.fill: "#eeeeee"
  style.stroke: "#616161"

  cuentas: "Cuentas\ninstitucionales" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/graduation-cap.svg
  }
}

vacio_2: { class: hueco }

# ── Fila 2 · Servidores del laboratorio ─────────────────────────────────────────────────────

monitoreo: "Monitoreo" {
  class: sub
  style.fill: "#f5f5f5"
  style.stroke: "#757575"

  vigia: "Vigila las\nmáquinas" {
    class: comp
    style.stroke: "#757575"
    icon: ${lucide}/activity.svg
  }
  teams: "Avisa por\nTeams" {
    class: comp
    style.stroke: "#757575"
    icon: ${marcas}/microsoftteams.svg
  }
  vigia -> teams
}

pi4: "Raspberry Pi 4 · Laboratorio" {
  class: sub
  style.fill: "#e8f1fb"
  style.stroke: "#1e88e5"
  icon: ${marcas}/raspberrypi.svg
  icon.near: outside-top-left
  grid-columns: 2

  terminal: "Terminal" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/terminal.svg
  }
  video: "Video en vivo" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/video.svg
  }
  practicas: "API de prácticas" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/book-open-check.svg
  }
  lab: "API del laboratorio" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/layout-dashboard.svg
  }
  bd: "Base de datos" {
    class: comp
    style.stroke: "#1e88e5"
    icon: ${lucide}/database.svg
  }
  lab -> bd
}

vacio_3: { class: hueco }

pi5: "Raspberry Pi 5 · Cursos y robot" {
  class: sub
  style.fill: "#e9f6ec"
  style.stroke: "#2e7d32"
  icon: ${marcas}/raspberrypi.svg
  icon.near: outside-top-left

  moodle: "Moodle" {
    class: comp
    style.stroke: "#2e7d32"
    icon: ${marcas}/moodle.svg
  }
  api_robot: "API del robot" {
    class: comp
    style.stroke: "#2e7d32"
    icon: ${lucide}/blocks.svg
  }
}

vacio_4: { class: hueco }

pi5_auto: "Raspberry Pi 5 · Automatización" {
  class: sub
  style.fill: "#f3ecfa"
  style.stroke: "#7e57c2"
  icon: ${marcas}/raspberrypi.svg
  icon.near: outside-top-left

  api_auto: "API de\nautomatización" {
    class: comp
    width: 330
    style.stroke: "#7e57c2"
    icon: ${lucide}/workflow.svg
  }
}

# ── Fila 3 · Tutor de voz (entre la Pi 4 y la Pi 5, con las que habla) ──────────────────────

vacio_5: { class: hueco }
vacio_6: { class: hueco }

jetson: "NVIDIA Jetson · Tutor de voz" {
  class: sub
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"
  icon: ${marcas}/nvidia.svg
  icon.near: outside-top-left

  voz: "Agente de voz" {
    class: comp
    width: 330
    style.stroke: "#ef6c00"
    icon: ${lucide}/audio-lines.svg
  }
}

vacio_7: { class: hueco }
vacio_8: { class: hueco }
vacio_9: { class: hueco }

# ── Fila 4 · Equipos reales (solo red interna) ──────────────────────────────────────────────

rotulo_equipos: "Equipos reales\nsolo red interna" {
  shape: text
  style: {
    font-size: 20
    bold: true
  }
}

camaras: "Cámaras" {
  class: sub
  style.fill: "#eeeeee"
  style.stroke: "#616161"

  cams: "5 cámaras IP" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/cctv.svg
  }
}

vacio_10: { class: hueco }

robot: "Robot" {
  class: sub
  style.fill: "#eeeeee"
  style.stroke: "#616161"

  ev3: "Robot LEGO EV3" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/bot.svg
  }
}

vacio_11: { class: hueco }

planta: "Proceso industrial" {
  class: sub
  style.fill: "#eeeeee"
  style.stroke: "#616161"

  plc: "PLC" {
    class: comp
    style.stroke: "#616161"
    icon: ${lucide}/cpu.svg
  }
}

# ── Conexiones ──────────────────────────────────────────────────────────────────────────────
# Van de subsistema a subsistema: el detalle de cada uno está dentro de su recuadro.

usuarios -> cliente: usa
cliente -> acceso: "inicia sesión"
acceso -> universidad: "valida cuentas"

cliente -> pi4: "terminal, video,\nprácticas y notas"
cliente -> pi5: "cursos y robot"
cliente -> pi5_auto: automatización
cliente -> jetson {
  target-arrowhead.label: voz
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}

pi4 -> pi5: "envía la nota\na Moodle"
jetson -> pi4: "lee la práctica" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}
jetson -> pi5: "estado del robot" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}
monitoreo -> pi4: vigila {
  style.stroke-dash: 4
}

pi4 <-> camaras: "video y\nmovimiento"
pi5 -> robot: ejecuta
pi5_auto -> planta: controla
