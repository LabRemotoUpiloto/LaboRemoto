# Arquitectura general de LaboRemoto: componentes y cómo interactúan.
# Vista de alto nivel: sin direcciones, puertos, protocolos ni el login (Keycloak).
# Render:  d2 docs/arquitectura/arquitectura-general.d2 docs/arquitectura/arquitectura-general.svg
#
# Para añadir un componente: copia un nodo (ícono + nombre corto) dentro de su máquina y agrega la
# flecha abajo, en «Conexiones». Íconos: Lucide y Simple Icons por jsDelivr, con versión fijada.
# Naranja = la voz; punteado = apoyo.

vars: {
  d2-config: {
    layout-engine: elk
    pad: 50
  }
  lucide: "https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons"
  marcas: "https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons"
}

direction: right

titulo: Arquitectura general de LaboRemoto {
  near: top-center
  shape: text
  style: {
    font-size: 40
    bold: true
  }
}

classes: {
  nodo: {
    shape: image
    width: 130
    height: 80
    style.font-size: 18
    style.bold: true
  }
  maquina: {
    style: {
      border-radius: 14
      font-size: 22
      bold: true
      stroke-width: 2
    }
  }
}

# ── Quién lo usa ────────────────────────────────────────────────────────────────────────────

personas: "Estudiante · Docente · Admin" {
  class: nodo
  icon: ${lucide}/users.svg
  width: 100
  height: 100
}

app: "App de escritorio" {
  class: nodo
  icon: ${lucide}/app-window.svg
  width: 100
  height: 100
}

# ── Máquinas y sus componentes ──────────────────────────────────────────────────────────────

pi4: "Raspberry Pi 4" {
  class: maquina
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e8f1fb"
  style.stroke: "#1e88e5"

  terminal: "Terminal" {
    class: nodo
    icon: ${lucide}/terminal.svg
  }
  video: "Video en vivo" {
    class: nodo
    icon: ${lucide}/video.svg
  }
  practicas: "API de prácticas" {
    class: nodo
    icon: ${lucide}/book-open-check.svg
  }
  lab: "API del laboratorio" {
    class: nodo
    icon: ${lucide}/layout-dashboard.svg
  }
  bd: "Base de datos" {
    class: nodo
    icon: ${lucide}/database.svg
  }

  lab -> bd
}

pi5: "Raspberry Pi 5" {
  class: maquina
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e9f6ec"
  style.stroke: "#2e7d32"

  moodle: "Moodle" {
    class: nodo
    icon: ${marcas}/moodle.svg
  }
  api_robot: "API del robot" {
    class: nodo
    icon: ${lucide}/bot.svg
  }
}

jetson: "NVIDIA Jetson" {
  class: maquina
  icon: ${marcas}/nvidia.svg
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"

  voz: "Tutor de voz" {
    class: nodo
    icon: ${lucide}/audio-lines.svg
  }
}

monitoreo: "Monitoreo" {
  class: nodo
  icon: ${lucide}/activity.svg
}

teams: "Teams" {
  class: nodo
  icon: ${marcas}/microsoftteams.svg
}

# ── Equipos reales (solo red interna) ───────────────────────────────────────────────────────

equipos: "Equipos reales" {
  class: maquina
  style.fill: "#eeeeee"
  style.stroke: "#616161"

  camaras: "5 cámaras" {
    class: nodo
    icon: ${lucide}/cctv.svg
  }
  robot: "Robot EV3" {
    class: nodo
    icon: ${lucide}/bot.svg
  }
}

# ── Conexiones ──────────────────────────────────────────────────────────────────────────────

personas -> app: usa

app -> pi4.terminal: terminal
app -> pi4.video: video
app -> pi4.practicas: prácticas
app -> pi4.lab: "sesiones y notas"
app -> pi5.moodle: cursos
app -> pi5.api_robot: bloques
app -> jetson.voz: voz {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}

pi4.lab -> pi5.moodle: nota
pi4.lab -> equipos.camaras: mueve
equipos.camaras -> pi4.video: imagen

jetson.voz -> pi4.practicas: "lee la práctica" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}
jetson.voz -> pi5.api_robot: "estado" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}

pi5.api_robot -> equipos.robot: ejecuta

monitoreo -> pi4: vigila {
  style.stroke-dash: 4
}
monitoreo -> teams: alerta {
  style.stroke-dash: 4
}
