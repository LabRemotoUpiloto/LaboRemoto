# Arquitectura general de LaboRemoto: componentes y cómo interactúan, de arriba hacia abajo.
# Vista de alto nivel: sin direcciones, puertos ni protocolos.
# Render:  d2 docs/arquitectura/arquitectura-general.d2 docs/arquitectura/arquitectura-general.svg
#
# Es una cuadrícula de 6 columnas y 4 filas (en ese orden de lectura). Las celdas «vacio_*» son
# huecos para que las flechas queden rectas. Filas: 1 persona, app e inicio de sesión · 2 servidores
# · 3 tutor de voz · 4 equipos reales. Para añadir un componente: copia un nodo (ícono + nombre
# corto) a su máquina y agrega la flecha abajo, en «Conexiones».
# Íconos: Lucide y Simple Icons por jsDelivr, con versión fijada. Naranja = la voz; punteado = apoyo.

vars: {
  d2-config: {
    pad: 50
  }
  lucide: "https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons"
  marcas: "https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons"
}

classes: {
  nodo: {
    shape: image
    width: 130
    height: 80
    style.font-size: 18
    style.bold: true
  }
  maquina: {
    icon.near: outside-top-left
    style: {
      border-radius: 14
      font-size: 22
      bold: true
      stroke-width: 2
    }
  }
  hueco: {
    label: ""
    width: 20
    height: 20
    style: {
      opacity: 0
    }
  }
}

grid-rows: 4
grid-columns: 6
grid-gap: 120

# ── Fila 1 · Quién lo usa y cómo inicia sesión ──────────────────────────────────────────────

vacio_1: { class: hueco }

personas: "Estudiante\nDocente · Admin" {
  class: nodo
  icon: ${lucide}/users.svg
  width: 100
  height: 100
}

app: "App de escritorio" {
  class: nodo
  icon: ${lucide}/app-window.svg
  width: 100
  height: 100
}

login: "Servidor de\ninicio de sesión" {
  class: nodo
  icon: ${lucide}/shield-check.svg
  width: 160
}

universidad: "Universidad" {
  class: nodo
  icon: ${lucide}/graduation-cap.svg
}

vacio_2: { class: hueco }

# ── Fila 2 · Servidores del laboratorio ─────────────────────────────────────────────────────

monitoreo: "Monitoreo\n(avisa por Teams)" {
  class: nodo
  icon: ${lucide}/activity.svg
}

pi4: "Raspberry Pi 4" {
  class: maquina
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e8f1fb"
  style.stroke: "#1e88e5"
  grid-columns: 2

  terminal: "Terminal" {
    class: nodo
    icon: ${lucide}/terminal.svg
  }
  video: "Video en vivo" {
    class: nodo
    icon: ${lucide}/video.svg
  }
  practicas: "API de prácticas" {
    class: nodo
    icon: ${lucide}/book-open-check.svg
  }
  lab: "API del laboratorio" {
    class: nodo
    icon: ${lucide}/layout-dashboard.svg
  }
}

vacio_3: { class: hueco }

pi5: "Raspberry Pi 5" {
  class: maquina
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#e9f6ec"
  style.stroke: "#2e7d32"

  moodle: "Moodle" {
    class: nodo
    icon: ${marcas}/moodle.svg
  }
  api_robot: "API del robot" {
    class: nodo
    icon: ${lucide}/blocks.svg
  }
}

vacio_4: { class: hueco }

pi5_auto: "Raspberry Pi 5\nAutomatización" {
  class: maquina
  icon: ${marcas}/raspberrypi.svg
  style.fill: "#f3ecfa"
  style.stroke: "#7e57c2"

  api_auto: "API de\nautomatización" {
    class: nodo
    width: 260
    icon: ${lucide}/workflow.svg
  }
}

# ── Fila 3 · Tutor de voz (entre la Pi 4 y la Pi 5, con las que habla) ──────────────────────

vacio_5: { class: hueco }
vacio_6: { class: hueco }

jetson: "NVIDIA Jetson" {
  class: maquina
  icon: ${marcas}/nvidia.svg
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"

  voz: "Tutor de voz" {
    class: nodo
    width: 260
    icon: ${lucide}/audio-lines.svg
  }
}

vacio_7: { class: hueco }
vacio_8: { class: hueco }
vacio_9: { class: hueco }

# ── Fila 4 · Equipos reales (solo red interna) ──────────────────────────────────────────────

rotulo_equipos: "Equipos reales\nsolo red interna" {
  shape: text
  style: {
    font-size: 20
    bold: true
  }
}

camaras: "5 cámaras" {
  class: nodo
  icon: ${lucide}/cctv.svg
}

vacio_10: { class: hueco }

robot: "Robot EV3" {
  class: nodo
  icon: ${lucide}/bot.svg
}

vacio_11: { class: hueco }

plc: "PLC" {
  class: nodo
  icon: ${lucide}/cpu.svg
}

# ── Conexiones ──────────────────────────────────────────────────────────────────────────────

personas -> app: usa
app -> login: "inicia sesión"
login -> universidad: cuentas

app -> pi4: "terminal, video,\nprácticas y notas"
app -> pi5: "cursos y robot"
app -> pi5_auto: automatización
app -> jetson {
  target-arrowhead.label: voz
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}

pi4 -> pi5: "envía la nota\na Moodle"
jetson -> pi4: "lee la práctica" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}
jetson -> pi5: "estado del robot" {
  style: {
    stroke: "#ef6c00"
    stroke-width: 3
  }
}
monitoreo -> pi4: vigila {
  style.stroke-dash: 4
}

pi4 <-> camaras: "video y\nmovimiento"
pi5 -> robot: ejecuta
pi5_auto -> plc: controla
